# ==============================================================================
# ROE BOLET - Production Environment Variables Template (.env.production)
# Instructions : Copiez ce fichier vers .env.production sur le serveur hôte
# et remplacez les secrets par des clés à haute entropie (ex: openssl rand -hex 32).
# ==============================================================================

# --- BASE DE DONNÉES POSTGRESQL ---
POSTGRES_USER=roe_admin
POSTGRES_PASSWORD=CHANGE_ME_TO_A_SUPER_STRONG_PASSWORD_2026!
POSTGRES_DB=roe_bolet_db

# --- CACHE & PUB/SUB REDIS ---
REDIS_PASSWORD=CHANGE_ME_TO_A_SECURE_REDIS_AUTH_TOKEN_2026!

# --- SÉCURITÉ CRYPTOGRAPHIQUE DU BACKEND ---
# Générer avec : openssl rand -base64 48
JWT_SECRET=CHANGE_ME_PRODUCTION_JWT_SECRET_KEY_MINIMUM_64_CHARS_LENGTH
JWT_EXPIRATION=86400

# Clé secrète de signature HMAC-SHA256 des QR Codes & Tickets
HMAC_TICKET_SECRET=CHANGE_ME_HMAC_SHA256_TICKET_SIGNATURE_KEY_VERY_LONG_STRING

# Clé secrète de scellement cryptographique des résultats de tirage
DRAW_VALIDATION_SECRET=CHANGE_ME_HMAC_SHA256_DRAW_RESULTS_SEAL_KEY_VERY_LONG_STRING

# --- RÈGLES MÉTIER ET DÉLAIS LÉGAUX ---
CANCELLATION_WINDOW_MINUTES=5
TICKET_EXPIRATION_DAYS=90

# --- EXPOSITION PORTS & PROXY NGINX ---
HTTP_PORT=80
HTTPS_PORT=443

# --- FRONTEND ADMIN DASHBOARD ---
NEXT_PUBLIC_API_URL=/api/v1
