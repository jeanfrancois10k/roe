# ROE BOLET - Configuration Environnement Backend (Exemple)
PORT=4000
NODE_ENV=development

DATABASE_URL="postgresql://user:password@localhost:5432/roe_bolet_db?schema=public"

JWT_ACCESS_SECRET="change_me_super_secret_access_key"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_SECRET="change_me_super_secret_refresh_key"
JWT_REFRESH_EXPIRATION="7d"

REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD=""

HMAC_TICKET_SECRET="change_me_hmac_secret"
CANCELLATION_WINDOW_MINUTES=5
